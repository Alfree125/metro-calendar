<?xml version="1.0" encoding="utf-8"?>
<!-- Scheda attiva: binario giallo con la fermata al centro -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_vertical|fill_horizontal" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/giallo" />
        </shape>
    </item>
    <item android:gravity="center" android:width="7dp" android:height="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/giallo" />
        </shape>
    </item>
</layer-list>
