<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nero"
    android:orientation="vertical">

    <include layout="@layout/striscia" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/titolo_foglio"
            style="@style/TitoloFoglio"
            android:text="@string/titolo_nuovo" />

        <ImageButton
            android:id="@+id/btn_azione"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_cerchio_scuro"
            android:contentDescription="@string/ripristina"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ripristina"
            app:tint="@color/bianco" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scorrimento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/foglio"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/modulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp"
            android:visibility="invisible">

            <TextView
                style="@style/EtichettaFoglio"
                android:text="@string/nome_evento" />

            <EditText
                android:id="@+id/in_titolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/campo_titolo"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingVertical="8dp"
                android:textColor="@color/inchiostro"
                android:textColorHint="#FF8E8E8E"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/errore_titolo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/errore_titolo"
                android:textColor="#FFBA1A1A"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nota_ricorrente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/evento_ricorrente"
                android:textColor="@color/inchiostro_tenue"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/riga_tutto_giorno"
                style="@style/RigaFoglio"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/TestoRiga"
                    android:text="@string/tutto_il_giorno" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_tutto_giorno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/RigaFoglio">

                <TextView
                    style="@style/TestoRiga"
                    android:text="@string/inizio" />

                <TextView
                    android:id="@+id/val_data_inizio"
                    style="@style/ValoreRiga" />

                <TextView
                    android:id="@+id/val_ora_inizio"
                    style="@style/ValoreRiga"
                    android:layout_marginStart="20dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_fine"
                style="@style/RigaFoglio"
                android:visibility="gone">

                <TextView
                    style="@style/TestoRiga"
                    android:text="@string/fine" />

                <TextView
                    android:id="@+id/val_data_fine"
                    style="@style/ValoreRiga" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_durata"
                style="@style/RigaFoglio">

                <TextView
                    style="@style/TestoRiga"
                    android:text="@string/campo_durata" />

                <TextView
                    android:id="@+id/val_durata"
                    style="@style/ValoreRiga"
                    android:drawableEnd="@drawable/ic_su_giu"
                    android:drawablePadding="2dp"
                    android:drawableTint="#FF555555" />
            </LinearLayout>

            <TextView
                android:id="@+id/errore_orario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/errore_fine"
                android:textColor="#FFBA1A1A"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/riga_linea"
                style="@style/RigaFoglio"
                android:layout_marginTop="20dp">

                <TextView
                    style="@style/TestoRiga"
                    android:text="@string/campo_linea" />

                <ImageView
                    android:id="@+id/pallino_linea"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/val_linea"
                    style="@style/ValoreRiga"
                    android:drawableEnd="@drawable/ic_su_giu"
                    android:drawablePadding="2dp"
                    android:drawableTint="#FF555555"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:textColor="@color/inchiostro"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Promemoria: uno o piu', ciascuno con la sua X -->
            <LinearLayout style="@style/RigaFoglio">

                <TextView
                    style="@style/TestoRiga"
                    android:text="@string/promemoria_titolo" />

                <TextView
                    android:id="@+id/val_nessun_promemoria"
                    style="@style/ValoreRiga"
                    android:text="@string/nessun_promemoria" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lista_promemoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/riga_aggiungi_promemoria"
                style="@style/RigaFoglio"
                android:minHeight="44dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_aggiungi_cerchio"
                    app:tint="@color/inchiostro" />

                <TextView
                    style="@style/TestoRiga"
                    android:layout_marginStart="8dp"
                    android:text="@string/aggiungi_promemoria"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_luogo_note"
                style="@style/RigaFoglio"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_aggiungi_cerchio"
                    app:tint="@color/inchiostro_tenue" />

                <TextView
                    style="@style/TestoRiga"
                    android:layout_marginStart="8dp"
                    android:text="@string/luogo_e_note"
                    android:textColor="@color/inchiostro_tenue"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gruppo_luogo_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/EtichettaFoglio"
                    android:layout_marginTop="8dp"
                    android:text="@string/campo_luogo" />

                <EditText
                    android:id="@+id/in_luogo"
                    style="@style/CampoFoglio"
                    android:inputType="textCapSentences|textPostalAddress"
                    android:maxLines="1" />

                <TextView
                    style="@style/EtichettaFoglio"
                    android:layout_marginTop="16dp"
                    android:text="@string/campo_note" />

                <EditText
                    android:id="@+id/in_note"
                    style="@style/CampoFoglio"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_salva"
                style="@style/PulsanteNero"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:text="@string/salva_evento" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
