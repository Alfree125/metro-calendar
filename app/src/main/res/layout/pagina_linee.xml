<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nero">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TitoloCartello"
                    android:text="@string/linee"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/data_linee"
                    style="@style/Didascalia"
                    android:layout_marginTop="2dp"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_impostazioni_linee"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_cerchio_scuro"
                android:contentDescription="@string/impostazioni"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_impostazioni"
                app:tint="@color/bianco" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lista_linee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/nessuna_linea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:text="@string/nessuna_linea"
            android:textColor="@color/grigio"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_aggiungi_linea"
            style="@style/PulsanteCartello"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/aggiungi_linea" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
