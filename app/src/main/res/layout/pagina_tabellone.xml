<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Intestazione nera: data su due righe, impostazioni, pallini delle linee, tutto il giorno -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nero"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/data_tabellone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/scegli_giorno"
                android:lineSpacingMultiplier="0.95"
                android:textColor="@color/bianco"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_impostazioni"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_cerchio_scuro"
                android:contentDescription="@string/impostazioni"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_impostazioni"
                app:tint="@color/bianco" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/linee_giorno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/btn_oggi"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pillola"
                android:backgroundTint="@color/bianco"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingHorizontal="14dp"
                android:text="@string/oggi"
                android:textAllCaps="true"
                android:textColor="@color/inchiostro"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pillola_tutto_giorno"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pillola"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingHorizontal="14dp"
                android:textAllCaps="true"
                android:textColor="@color/bianco"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nero"
        android:orientation="horizontal"
        android:paddingStart="62dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Didascalia"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/partenze"
            android:textColor="#FFD0D0D0" />

        <TextView
            style="@style/Didascalia"
            android:text="@string/orario"
            android:textColor="#FFD0D0D0" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/carta">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scorrimento_tabellone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/lista_tabellone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/vuoto_tabellone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nessuna_partenza"
                android:textColor="@color/inchiostro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vuoto_tabellone_testo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/inchiostro_tenue"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/suggerimento_tabellone"
                android:textColor="@color/inchiostro_tenue"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
