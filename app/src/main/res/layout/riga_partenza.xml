<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/carta"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/contenuto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/pallino"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/etichetta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_etichetta"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="@string/live"
                android:textAllCaps="true"
                android:textColor="@color/bianco"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/titolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/inchiostro"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/luogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/inchiostro_tenue"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/orario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textAllCaps="true"
                android:textColor="@color/inchiostro"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="64dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/numero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="@color/inchiostro"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/unita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textColor="@color/inchiostro"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/avanzamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:visibility="gone"
        app:indicatorColor="@color/inchiostro"
        app:trackColor="#33000000"
        app:trackCornerRadius="0dp"
        app:trackStopIndicatorSize="0dp"
        app:indicatorTrackGapSize="0dp"
        app:trackThickness="3dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/carta_filetto" />
</LinearLayout>
