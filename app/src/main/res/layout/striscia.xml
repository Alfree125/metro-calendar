<?xml version="1.0" encoding="utf-8"?>
<!-- Striscia in alto col nome dell'app (nel video: "SAMPLE DAY  ×") -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nero"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/striscia_nome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/bianco"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/striscia_chiudi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chiudi"
            android:src="@drawable/ic_chiudi"
            app:tint="@color/bianco"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/separatore_linee" />
</LinearLayout>
